<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Work around https://github.com/dotnet/project-system/issues/4314 -->
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>13</LangVersion>
    <IsPackable>false</IsPackable>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>../bin/Content.Shared</OutputPath>
    <AssemblyName>OpenDreamShared</AssemblyName>
    <Nullable>enable</Nullable>
    <NoWarn>NU1507</NoWarn>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="JetBrains.Annotations" />
    <PackageReference Include="System.CommandLine" />
    <!-- <PackageReference Include="YamlDotNet" /> -->
    <ProjectReference Include="..\OpenDreamCodeGenerators\OpenDreamCodeGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />  
  </ItemGroup>  
</Project>
